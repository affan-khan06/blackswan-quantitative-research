# GEMINI_API_KEY: Required for Gemini AI API calls (if optional AI extensions are enabled).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional BLACKSWAN Backend Overrides (defaults are configured in backend/app/core/config.py)
# BLACKSWAN_ENV="development"
# DATABASE_URL="sqlite:///./data/blackswan.db"
# For PostgreSQL (Docker Compose / Production):
# DATABASE_URL="postgresql+psycopg2://blackswan:blackswan_dev@postgres:5432/blackswan"
# BLACKSWAN_DATA_DIR="./data"
# BLACKSWAN_DEFAULT_RISK_FREE_RATE="0.065"
# BLACKSWAN_TRADING_DAYS_PER_YEAR="252"
# BLACKSWAN_BACKEND_PORT="8787"
